---
import "@fontsource/spectral/300.css";
import "@fontsource/spectral/400.css";
import "@fontsource/spectral/300-italic.css";
import "@fontsource/spectral/400-italic.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "../styles/global.css";

const title = "Dr Finlay McCall — Learn to work better with AI";
const description =
  "Dr Finlay McCall is an educator and researcher who helps people and teams build lasting judgement for working with AI. PhD in human-AI collaboration, University of Canberra.";
const thesisUrl =
  "https://researchprofiles.canberra.edu.au/en/studentTheses/anticipating-curriculum-and-course-design-for-humanai-collaborati/";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://finlaymccall.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://finlaymccall.com/" />
    <meta property="og:image" content="https://finlaymccall.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Opts the page into entrance transitions only when JS is available,
         so nothing is hidden for no-JS visitors. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <!-- Duotone filter for the portrait: shadows to deep teal, highlights to paper -->
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <filter id="duotone" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0 0 0 1 0"></feColorMatrix>
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.086 0.980"></feFuncR>
          <feFuncG type="table" tableValues="0.212 0.973"></feFuncG>
          <feFuncB type="table" tableValues="0.188 0.957"></feFuncB>
        </feComponentTransfer>
      </filter>
    </svg>

    <header class="site-header">
      <div class="container">
        <a class="wordmark" href="/">Dr Finlay McCall</a>
        <div class="header-right">
          <nav class="nav" aria-label="Primary">
            <a href="#work">Work with me</a>
            <a href="#approach">Approach</a>
            <a href="#about">About</a>
          </nav>
          <a class="btn btn-small" href="#contact">Get in touch</a>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero" aria-label="Introduction">
        <div class="container">
          <div class="hero-text">
            <p class="eyebrow">Educator &amp; researcher &middot; Canberra, Australia</p>
            <h1>Most AI training teaches tools. <span class="no-wrap-wide">I teach judgement.</span></h1>
            <p class="lede">
              AI is now part of ordinary work, but almost no one has been taught to
              use it well. I'm an educator with a doctorate in human&ndash;AI
              collaboration, and I help people and teams build the judgement to use
              AI on their own terms.
            </p>
            <div class="hero-cta">
              <a class="btn" data-email href="#contact">
                Start a conversation <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
              <span class="alt">
                or write to <a data-email data-email-text href="#contact"
                  ><noscript>hi [at] finlaymccall.com</noscript></a
                >
              </span>
            </div>
            <p class="credentials-strip">
              <span class="cred-item">PhD, Human&ndash;AI Collaboration</span><span
                class="sep"
                aria-hidden="true">&middot;</span
              ><span class="cred-item">University of Canberra</span><span
                class="sep"
                aria-hidden="true">&middot;</span
              ><span class="cred-item">Published in Phil. Trans. of the Royal Society&nbsp;A</span>
            </p>
          </div>
          <img
            class="hero-portrait"
            src="/finlay-mccall.jpg"
            width="450"
            height="450"
            alt="Dr Finlay McCall"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </section>

      <!-- Work with me -->
      <section id="work" class="reveal" aria-labelledby="work-title">
        <div class="container">
          <h2 id="work-title" class="section-title">Work with me</h2>
          <p class="section-lede">
            Most people don't need a one-off course on the latest AI tool. They need
            the capacity to keep learning as the tools change.
          </p>

          <div class="offer">
            <div class="item">
              <h3>Advisory conversation</h3>
              <p>
                One session to work out what AI actually means for your role or
                field &mdash; what to take seriously, what to ignore, and what to
                try first.
              </p>
            </div>
            <div class="item">
              <h3>Coaching &amp; workshops</h3>
              <p>
                Ongoing work with individuals or teams on the AI in your real
                workflows &mdash; writing, research, analysis &mdash; until good use
                is a habit, not an event.
              </p>
            </div>
            <div class="item">
              <h3>AI capability review</h3>
              <p>
                For organisations deciding where AI belongs and where it doesn't
                &mdash; and what your people need to learn before adoption becomes
                policy.
              </p>
            </div>
          </div>

          <p class="closing">
            Not sure which fits? <a data-email href="#contact">Start with an email
            <span aria-hidden="true">&rarr;</span></a>
          </p>
        </div>
      </section>

      <!-- My approach -->
      <section id="approach" class="reveal" aria-labelledby="approach-title">
        <div class="container">
          <h2 id="approach-title" class="section-title">My approach</h2>
          <div class="prose">
            <p>
              I come to AI through education. Good AI use isn't a matter of knowing
              which tool to open or which prompt to copy &mdash; it's a learning
              problem. People need to understand what they're trying to do, what the
              system can and can't help with, how to judge the output, and how to
              keep improving over time.
            </p>
            <p>
              My work usually begins with a needs analysis: what are you trying to
              do, what do people already know, and where are the risks, gaps, and
              opportunities? From there, I shape the content, routines, and
              evaluation that make AI useful in your setting.
            </p>
          </div>

          <blockquote class="pull-quote">
            Tools change. The point is to build capability that survives the next
            product update.
          </blockquote>

          <div class="prose">
            <p>
              This framing grew out of <a href={thesisUrl}>my doctoral research</a>
              at the University of Canberra, where I studied how people and AI
              systems can be prepared to work together deliberately over time.
            </p>
          </div>
        </div>
      </section>

      <!-- About -->
      <section id="about" class="reveal" aria-labelledby="about-title">
        <div class="container">
          <h2 id="about-title" class="section-title">About</h2>
          <div class="prose">
            <p>
              I'm Dr Finlay McCall, an independent researcher and educator based in
              Australia. My PhD thesis, <em>Anticipating Curriculum and Course
              Design for Human-AI Collaboration</em>, examined how we design
              learning for the cognitive partnership between people and machines
              &mdash; a line of work I continue today through research and practice
              in human-machine education.
            </p>
            <p class="current-role">
              I'm currently Project Manager and Research Assistant on a University
              of Canberra and ACT Education Directorate research project on
              teachers' use of generative AI in schools, led by A/Prof Eleni
              Petraki.
            </p>
            <p>
              Before this, I spent more than twenty years teaching across Europe,
              Asia, and Australia.
            </p>
            <p>
              Pedagogy is the thread through all of it. It's the lens I bring to
              AI.
            </p>
          </div>

          <ul class="creds">
            <li>
              <span class="what">PhD in Education</span>
              <span class="where">University of Canberra</span>
            </li>
            <li>
              <span class="what">Master of Education (TESOL)</span>
              <span class="where">University of Sydney</span>
            </li>
            <li>
              <span class="what">Cambridge DELTA</span>
              <span class="where">Diploma in English Language Teaching</span>
            </li>
            <li>
              <span class="what">CELTA Teacher Trainer &amp; IELTS Examiner</span>
              <span class="where">Twenty years across Europe, Asia, and Australia</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Research -->
      <section id="research" class="reveal" aria-labelledby="research-title">
        <div class="container">
          <h2 id="research-title" class="section-title">Research</h2>
          <ul class="pubs">
            <li>
              <span class="year">2025</span>
              <span class="cite">
                <strong>PhD thesis.</strong>
                <a href={thesisUrl}
                  ><em>Anticipating Curriculum and Course Design for Human-AI
                    Collaboration</em></a
                >, University of Canberra.
                <span class="gloss">
                  How to design courses and curricula that prepare people to work
                  with AI deliberately, rather than react to it.
                </span>
              </span>
            </li>
            <li>
              <span class="year">2021</span>
              <span class="cite">
                Abbass, H., Petraki, E., Hussein, A., McCall, F., &amp; Elsawah, S.
                (2021). A model of symbiomemesis: machine education and
                communication as pillars for human-autonomy symbiosis.
                <em>Philosophical Transactions of the Royal Society A</em>.
                <a href="https://doi.org/10.1098/rsta.2020.0364">doi.org/10.1098/rsta.2020.0364</a>
                <span class="gloss">
                  A model for how humans and autonomous systems can learn from each
                  other over time &mdash; education as a two-way street.
                </span>
              </span>
            </li>
            <li>
              <span class="year">2021</span>
              <span class="cite">
                McCall, F., Hussein, A., Petraki, E., Elsawah, S., &amp; Abbass, H.
                (2021). Towards a systematic educational framework for human-machine
                teaming. <em>IEEE International Conference on Engineering,
                Technology &amp; Education (TALE)</em>, 375&ndash;382.
                <a href="https://doi.org/10.1109/TALE52509.2021.9678853">doi.org/10.1109/TALE52509.2021.9678853</a>
              </span>
            </li>
            <li>
              <span class="year">2017</span>
              <span class="cite">
                McCall, F. (2017). Using microblogs on Facebook to develop students'
                academic reading and writing skills.
                <em>University of Sydney Papers in TESOL</em>, 12.
              </span>
            </li>
          </ul>
          <p class="pubs-more">
            Full list on
            <a href="https://scholar.google.com/citations?hl=en&user=I4O0mMwAAAAJ"
              >Google Scholar <span aria-hidden="true">&rarr;</span></a
            >
          </p>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="contact reveal" aria-labelledby="contact-title">
        <div class="container">
          <h2 id="contact-title" class="section-title">Start a conversation</h2>
          <p>
            If you're trying to work out where AI fits into your work, the best
            place to start is a conversation. Tell me what you're working on, what
            you're unsure about, and what you want AI to help with.
          </p>
          <a class="contact-email" data-email data-email-text href="#"
            ><noscript>hi [at] finlaymccall.com</noscript></a
          >
          <div class="contact-lines">
            <a href="https://www.linkedin.com/in/finlay-mccall-39079725/">LinkedIn</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>&copy; 2026 Dr Finlay McCall</span>
        <span class="links">
          <a href="https://orcid.org/0000-0003-1397-1212">ORCID</a>
          <a href="https://scholar.google.com/citations?hl=en&user=I4O0mMwAAAAJ">Google Scholar</a>
          <a href="https://www.researchgate.net/profile/Finlay-Mccall">ResearchGate</a>
          <a href="https://www.linkedin.com/in/finlay-mccall-39079725/">LinkedIn</a>
          <a href="https://github.com/drfinlaymccall">GitHub</a>
        </span>
      </div>
    </footer>

    <!--
      Contact obfuscation: the email address is assembled at runtime from parts,
      so scrapers reading the static HTML do not find a plain mailto link.
      Cloudflare's email obfuscation adds a second layer for the address.
    -->
    <script is:inline>
      (function () {
        var user = "hi";
        var domain = "finlaymccall.com";
        var addr = user + "@" + domain;
        var nodes = document.querySelectorAll("[data-email]");
        for (var i = 0; i < nodes.length; i++) {
          nodes[i].setAttribute("href", "mailto:" + addr);
          if (nodes[i].hasAttribute("data-email-text")) {
            nodes[i].textContent = addr;
          }
        }
      })();
    </script>

    <!-- Fade-up on section entry; runs once per section, skipped when the
         visitor prefers reduced motion. -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.remove("js");
          return;
        }
        var sections = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          document.documentElement.classList.remove("js");
          return;
        }
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        sections.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
