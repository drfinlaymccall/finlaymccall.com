---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/500-italic.css';
import '../styles/global.css';
import Glyph from '../components/Glyph.astro';
import Icon from '../components/Icon.astro';
const {title = 'Dr Finlay McCall | Automation and Intelligence Specialist', description = 'Designing dependable systems and developing human judgement, creativity and capability.'} = Astro.props;
// Internal links are written from the site root. `base` is empty unless the site is served from a sub-path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Each page declares its own address, so search engines and link previews agree on one URL per page.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>

  <meta property="og:type" content="website"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="container site-header">
  <a class="wordmark" href={`${base}/`}>
    <Glyph kind="both"/>
    <span class="wm-name">Dr Finlay McCall</span>
    <span class="wm-desc">Automation <i>&amp; Intelligence</i></span>
  </a>
  <nav aria-label="Main navigation">
    <a href={`${base}/#work`}>Work</a>
    <a href={`${base}/#approach`}>Approach</a>
    <a href={`${base}/#experience`}>Experience</a>
    <a class="nav-cta" href={`${base}/#contact`}>Let’s talk</a>
  </nav>
</header>
<main id="main"><slot/></main>
<footer class="container site-footer">
  <p class="footer-name"><Glyph kind="both"/>Dr Finlay McCall · Australia</p>
  <p class="footer-links"><a href="https://github.com/drfinlaymccall">GitHub <Icon kind="out"/></a> <a data-email href={`${base}/#contact`}>Email <Icon kind="out"/></a></p>
  <small>Research-led. Human-directed. Designed to be understood and adapted.</small>
</footer>

<!-- The contact address is assembled in the browser, so the static HTML holds no plain
     mailto link for scrapers to harvest. Any element marked data-email becomes an email link.
     data-email-subject adds a subject line. A child marked data-email-text shows the address.
     Without JavaScript the links fall back to the contact section, which shows a readable hint. -->
<script is:inline>
  (function () {
    var user = "hi";
    var domain = "finlaymccall.com";
    var addr = user + "@" + domain;
    var nodes = document.querySelectorAll("[data-email]");
    for (var i = 0; i < nodes.length; i++) {
      var subject = nodes[i].getAttribute("data-email-subject");
      nodes[i].setAttribute("href", "mailto:" + addr + (subject ? "?subject=" + encodeURIComponent(subject) : ""));
      var slot = nodes[i].querySelector("[data-email-text]");
      if (slot) slot.textContent = addr;
    }
  })();
</script>
</body>
</html>
